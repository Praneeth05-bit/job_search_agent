# Copy this file to .env and fill in real values. Never commit .env.

# Gemini API key from Google AI Studio. Leave empty when USE_MOCK_MODEL=true.
GEMINI_API_KEY=

# Model name (approved during preflight).
GEMINI_MODEL=gemini-3.6-flash

# Seconds to wait for a model response before giving up.
MODEL_TIMEOUT_SECONDS=30

# Retries for temporary failures (429, 5xx, timeouts). Allowed: 0-5.
MODEL_MAX_RETRIES=2

# true = use canned responses, no API calls (tests, CI, offline work).
USE_MOCK_MODEL=false

# Maximum tool calls per agent run. Allowed: 1-10.
MAX_TOOL_CALLS=5

# Optional: folder of opportunity JSON files. Defaults to data/demo/opportunities.
# DATA_DIR=data/demo/opportunities

# Optional: where approved shortlists are saved. Defaults to data/tracker/shortlist.json.
# TRACKER_PATH=data/tracker/shortlist.json

# Lowest log level written: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# true = one JSON object per log line (for log tools); false = readable lines.
LOG_JSON=false

# Where the Streamlit UI finds the API.
API_BASE_URL=http://127.0.0.1:8000

# Seconds the UI waits for one agent request (a run makes several model calls).
UI_REQUEST_TIMEOUT_SECONDS=120
